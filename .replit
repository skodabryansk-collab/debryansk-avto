modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 19052
externalPort = 3000

[[ports]]
localPort = 20130
externalPort = 3003

[[ports]]
localPort = 23744
externalPort = 3002

[userenv]

[userenv.shared]
VITE_YANDEX_MAPS_KEY = "56483475-6a94-4d85-9bb2-d43e6cd7c533"
CM_EXPERT_TOKEN_URL = "https://lk.cm.expert/oauth/token"
CM_EXPERT_API_URL = "https://appraisal.api.cm.expert/v1"
SMTP_HOST = "smtp.timeweb.ru"
SMTP_PORT = "465"
SMTP_USER = "sales@debryansk-auto.ru"
SMTP_TO = "sales@debryansk-auto.ru"

[nix]
channel = "stable-25_05"
