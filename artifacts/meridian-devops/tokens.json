{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F4F1EA", "$description": "Warm paper used across the poster." },
      "foreground": { "$value": "#0D0D0D", "$description": "Near-black editorial ink." },
      "border": { "$value": "#AFADA8", "$description": "Warm hairline derived from the poster's 30% ink rules." },
      "card": { "$value": "#F4F1EA" },
      "cardForeground": { "$value": "#0D0D0D" },
      "popover": { "$value": "#F4F1EA" },
      "popoverForeground": { "$value": "#0D0D0D" },
      "primary": {
        "$value": "#E63312",
        "$description": "Signal red used for the active day, headline emphasis, and command highlights."
      },
      "primaryForeground": { "$value": "#F4F1EA" },
      "secondary": { "$value": "#0D0D0D", "$description": "Editorial ink for strong secondary actions and typography." },
      "secondaryForeground": { "$value": "#F4F1EA" },
      "muted": { "$value": "#E9E6DE" },
      "mutedForeground": { "$value": "#5A5751" },
      "accent": { "$value": "#E9E6DE", "$description": "A restrained paper tint for supporting surfaces." },
      "accentForeground": { "$value": "#0D0D0D" },
      "destructive": { "$value": "#E63312" },
      "destructiveForeground": { "$value": "#F4F1EA" },
      "input": { "$value": "#AFADA8" },
      "ring": { "$value": "#E63312" },
      "chart1": { "$value": "#E63312" },
      "chart2": { "$value": "#0D0D0D" },
      "chart3": { "$value": "#625F5A" },
      "chart4": { "$value": "#AFADA8" },
      "chart5": { "$value": "#D8D4CC" },
      "sidebar": { "$value": "#101010" },
      "sidebarForeground": { "$value": "#F4F1EA" },
      "sidebarBorder": { "$value": "#333333" },
      "sidebarPrimary": { "$value": "#E63312" },
      "sidebarPrimaryForeground": { "$value": "#F4F1EA" },
      "sidebarAccent": { "$value": "#1F1F1F" },
      "sidebarAccentForeground": { "$value": "#F4F1EA" },
      "sidebarRing": { "$value": "#F4F1EA" }
    },
    "dark": {
      "background": { "$value": "#101010" },
      "foreground": { "$value": "#F4F1EA" },
      "border": { "$value": "#3A3A3A" },
      "card": { "$value": "#171717" },
      "cardForeground": { "$value": "#F4F1EA" },
      "popover": { "$value": "#171717" },
      "popoverForeground": { "$value": "#F4F1EA" },
      "primary": { "$value": "#E63312" },
      "primaryForeground": { "$value": "#F4F1EA" },
      "secondary": { "$value": "#2B2B2B" },
      "secondaryForeground": { "$value": "#F4F1EA" },
      "muted": { "$value": "#292929" },
      "mutedForeground": { "$value": "#B8B4AC" },
      "accent": { "$value": "#292929" },
      "accentForeground": { "$value": "#F4F1EA" },
      "destructive": { "$value": "#E63312" },
      "destructiveForeground": { "$value": "#F4F1EA" },
      "input": { "$value": "#474747" },
      "ring": { "$value": "#E63312" },
      "chart1": { "$value": "#E63312" },
      "chart2": { "$value": "#F4F1EA" },
      "chart3": { "$value": "#C4C0B8" },
      "chart4": { "$value": "#74716C" },
      "chart5": { "$value": "#4B4945" },
      "sidebar": { "$value": "#101010" },
      "sidebarForeground": { "$value": "#F4F1EA" },
      "sidebarBorder": { "$value": "#333333" },
      "sidebarPrimary": { "$value": "#E63312" },
      "sidebarPrimaryForeground": { "$value": "#F4F1EA" },
      "sidebarAccent": { "$value": "#1F1F1F" },
      "sidebarAccentForeground": { "$value": "#F4F1EA" },
      "sidebarRing": { "$value": "#F4F1EA" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter Tight", "Helvetica", "Arial", "sans-serif"],
        "$description": "Display, headings, and body type; loaded from the source poster's Google Fonts link."
      },
      "serif": { "$value": ["Georgia", "serif"], "$description": "Unused fallback role; the source poster does not use a serif family." },
      "mono": {
        "$value": ["IBM Plex Mono", "SFMono-Regular", "monospace"],
        "$description": "Metadata, labels, dates, identifiers, and command text."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0px",
      "$description": "The source poster uses square-edged panels and hard rules."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
